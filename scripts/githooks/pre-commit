#!/usr/bin/env bash
# Refuses direct commits to main, then lints the staged Swift files with the
# same swift-format and SwiftLint rules CI runs. A missing tool is reported
# and skipped, not treated as a failure; CI still runs both.
set -u
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [[ "$branch" == "main" ]]; then
  echo "pre-commit: direct commits to main are not allowed. Create a branch and open a PR." >&2
  exit 1
fi

files=()
while IFS= read -r -d '' f; do files+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
(( ${#files[@]} == 0 )) && exit 0

fail=0
if swift format --version >/dev/null 2>&1; then
  swift format lint --strict --parallel "${files[@]}" || {
    echo "pre-commit: swift-format failed. Fix with: swift format --in-place ${files[*]}" >&2
    fail=1
  }
else
  echo "pre-commit: swift format not found, skipping (CI runs it)" >&2
fi

if command -v swiftlint >/dev/null 2>&1; then
  swiftlint lint --strict --quiet "${files[@]}" || fail=1
fi

exit "$fail"
