          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antenna lit les liens de guide de la playlist quand elle a fini de se charger."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna läser tablålänkarna från spellistan när den har lästs in."
          }
        }
