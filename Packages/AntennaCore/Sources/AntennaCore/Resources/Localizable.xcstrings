    "%@ rejected the login. Check the username and password in Settings, or ask the provider whether the account has expired." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ avvisade inloggningen. Kontrollera användarnamnet och lösenordet i Inställningar, eller fråga leverantören om kontot har gått ut."
          }
        }
      }
    },
    "%@ rejected the login. Sign in again on this Apple TV, or ask the provider whether the account has expired." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ avvisade inloggningen. Logga in igen på den här Apple TV:n, eller fråga leverantören om kontot har gått ut."
