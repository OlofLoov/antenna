    "%@ knows the channel but carries no programmes for it. Pick another entry below, or wait for the provider to fill it." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ känner till kanalen men har inga program för den. Välj en annan post nedan, eller vänta tills leverantören fyller på den."
          }
        }
      }
    },
    "%@ lists programmes for this channel but none after now. Wait for the next guide refresh or pick another entry below." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ listar program för den här kanalen men inga efter nu. Vänta på nästa tablåuppdatering eller välj en annan post nedan."
          }
        }
      }
    },
