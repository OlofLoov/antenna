    "%@ knows the channel but carries no programmes for it. Pick another entry below, or wait for the provider to fill it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ kennt den Sender, hat aber keine Sendungen dafür. Wähle unten einen anderen Eintrag oder warte, bis der Anbieter ihn füllt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ känner till kanalen men har inga program för den. Välj en annan post nedan, eller vänta tills leverantören fyller på den."
          }
        }
      }
    },
    "%@ lists programmes for this channel but none after now. Wait for the next guide refresh or pick another entry below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ listet Sendungen für diesen Sender, aber keine ab jetzt. Warte auf die nächste Aktualisierung des Programmführers oder wähle unten einen anderen Eintrag."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ listar program för den här kanalen men inga från och med nu. Vänta på nästa tablåuppdatering eller välj en annan post nedan."
          }
        }
      }
    },
    "%@ per %@ for %@, then %@ per year" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ pro %2$@ für %3$@, danach %4$@ pro Jahr"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ per %2$@ for %3$@, then %4$@ per year"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ per %2$@ i %3$@, sedan %4$@ per år"
          }
        }
      }
    },
    "%@ rejected the login. Check the username and password in Settings, or ask the provider whether the account has expired." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat die Anmeldung abgelehnt. Prüfe Benutzername und Passwort in den Einstellungen oder frag den Anbieter, ob das Konto abgelaufen ist."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avvisade inloggningen. Kontrollera användarnamnet och lösenordet i Inställningar, eller fråga leverantören om kontot har gått ut."
          }
        }
      }
    },
    "%@ rejected the login. Sign in again on this Apple TV, or ask the provider whether the account has expired." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat die Anmeldung abgelehnt. Melde dich auf diesem Apple TV erneut an oder frag den Anbieter, ob das Konto abgelaufen ist."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avvisade inloggningen. Logga in igen på den här Apple TV:n, eller fråga leverantören om kontot har gått ut."
          }
        }
      }
    },
    "%@ returned %@ for this channel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ hat für diesen Sender %2$@ zurückgegeben."
