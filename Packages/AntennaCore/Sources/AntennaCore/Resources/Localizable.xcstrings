    },
    "%@ returned 404 for this channel. The channel may have moved or been removed by the provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat für diesen Sender 404 zurückgegeben. Der Sender wurde vom Anbieter vielleicht verschoben oder entfernt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarade 404 för den här kanalen. Kanalen kan ha flyttats eller tagits bort av leverantören."
          }
        }
      }
    },
    "%@ returned a server error. Its server is having trouble. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat einen Serverfehler gemeldet. Der Server hat Probleme. Versuche es gleich noch einmal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarade med ett serverfel. Servern har problem. Försök igen om en stund."
          }
        }
      }
    },
    "%@ sent data that is not a playable stream. The address may point to a web page or an empty file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat Daten gesendet, die kein abspielbarer Stream sind. Die Adresse zeigt vielleicht auf eine Webseite oder eine leere Datei."
