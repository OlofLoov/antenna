    "%@ rejected the login. Check the username and password in Settings, or ask the provider whether the account has expired." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Anmeldung abgelehnt. Prüfe Benutzername und Passwort in den Einstellungen oder frag den Anbieter, ob das Konto abgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ rechazó el inicio de sesión. Revisa el usuario y la contraseña en Ajustes, o pregunta al proveedor si la cuenta ha caducado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a refusé la connexion. Vérifiez le nom d’utilisateur et le mot de passe dans Réglages, ou demandez au fournisseur si le compte a expiré."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avvisade inloggningen. Kontrollera användarnamnet och lösenordet i Inställningar, eller fråga leverantören om kontot har gått ut."
          }
        }
      }
    },
    "%@ rejected the login. Sign in again on this Apple TV, or ask the provider whether the account has expired." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Anmeldung abgelehnt. Melde dich auf diesem Apple TV erneut an oder frag den Anbieter, ob das Konto abgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ rechazó el inicio de sesión. Vuelve a iniciar sesión en este Apple TV, o pregunta al proveedor si la cuenta ha caducado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a refusé la connexion. Reconnectez-vous sur cette Apple TV, ou demandez au fournisseur si le compte a expiré."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avvisade inloggningen. Logga in igen på den här Apple TV:n, eller fråga leverantören om kontot har gått ut."
          }
        }
      }
    },
    "%@ returned %@ for this channel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat für diesen Sender %2$@ zurückgegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ returned %2$@ for this channel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ devolvió %2$@ para este canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ a renvoyé %2$@ pour cette chaîne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ svarade %2$@ för den här kanalen."
          }
        }
      }
    },
    "%@ returned 404 for this channel. The channel may have moved or been removed by the provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat für diesen Sender 404 zurückgegeben. Der Sender wurde vom Anbieter vielleicht verschoben oder entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ devolvió 404 para este canal. Puede que el proveedor lo haya movido o quitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a renvoyé 404 pour cette chaîne. Le fournisseur l’a peut-être déplacée ou supprimée."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarade 404 för den här kanalen. Kanalen kan ha flyttats eller tagits bort av leverantören."
          }
        }
      }
    },
    "%@ returned a server error. Its server is having trouble. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat einen Serverfehler gemeldet. Der Server hat Probleme. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ devolvió un error del servidor. Su servidor tiene problemas. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a renvoyé une erreur serveur. Son serveur rencontre des problèmes. Réessayez dans un instant."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarade med ett serverfel. Servern har problem. Försök igen om en stund."
          }
        }
      }
    },
    "%@ sent data that is not a playable stream. The address may point to a web page or an empty file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat Daten gesendet, die kein abspielbarer Stream sind. Die Adresse zeigt vielleicht auf eine Webseite oder eine leere Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ envió datos que no son una emisión reproducible. La dirección puede apuntar a una página web o a un archivo vacío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a envoyé des données qui ne sont pas un flux lisible. L’adresse renvoie peut-être vers une page web ou un fichier vide."
          }
        },
