          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsabonnemanget förnyas automatiskt tills det avslutas i Inställningar. Betalningen debiteras ditt Apple-konto."
          }
        }
      }
    },
    "Yearly renews automatically until canceled in Settings. Payment is charged to your Apple Account. Terms of Use and Privacy Policy." : {
