    },
    "Antenna has not asked to send notifications. Reminders show only while the app is open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يطلب Antenna إذن إرسال الإشعارات. تظهر التذكيرات فقط أثناء فتح التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna hat noch nicht gefragt, ob es Mitteilungen senden darf. Erinnerungen erscheinen nur, während die App geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna no ha pedido permiso para enviar notificaciones. Los recordatorios solo aparecen con la app abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna n’a pas demandé à envoyer des notifications. Les rappels ne s’affichent que lorsque l’app est ouverte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Antenna não pediu para enviar notificações. Os lembretes só aparecem com o app aberto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna har inte bett om att få skicka notiser. Påminnelser visas bara medan appen är öppen."
          }
        }
      }
    },
    "Antenna is locked again" : {
      "localizations" : {
