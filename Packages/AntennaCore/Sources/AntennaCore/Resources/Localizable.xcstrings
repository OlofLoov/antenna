          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna spelar ingen kanal just nu. Säg vilken kanal i stället."
          }
        }
      }
    },
    "Antenna isn't unlocked on this device yet. Open Antenna to continue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُفتح قفل Antenna على هذا الجهاز بعد. افتح Antenna للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna ist auf diesem Gerät noch nicht freigeschaltet. Öffne Antenna, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna aún no está desbloqueada en este dispositivo. Abre Antenna para continuar."
