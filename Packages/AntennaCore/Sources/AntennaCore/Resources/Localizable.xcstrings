    "Yearly renews automatically until canceled in Settings. Payment is charged to your Apple Account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد الاشتراك السنوي تلقائيًا حتى إلغائه في الإعدادات. يُحصَّل المبلغ من حساب Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Jahresabo verlängert sich automatisch, bis es in den Einstellungen gekündigt wird. Die Zahlung wird deinem Apple Account belastet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción anual se renueva automáticamente hasta que la canceles en Ajustes. El pago se carga en tu cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abonnement annuel se renouvelle automatiquement jusqu’à sa résiliation dans Réglages. Le paiement est débité de votre compte Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura anual renova automaticamente até ser cancelada em Ajustes. O pagamento é cobrado na sua Conta Apple."
          }
        },
