    "Antenna plays the TV sources you already have and includes no channels. One purchase unlocks every feature on iPhone, iPad, Mac and Apple TV, for everyone in your Family Sharing group." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna spielt die TV-Quellen ab, die du schon hast, und enthält keine Sender. Ein Kauf schaltet jede Funktion auf iPhone, iPad, Mac und Apple TV frei, für alle in deiner Familienfreigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna reproduce las fuentes de TV que ya tienes y no incluye canales. Una compra desbloquea todas las funciones en iPhone, iPad, Mac y Apple TV, para todos los miembros de tu grupo En familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antenna lit les sources TV que vous avez déjà et ne contient aucune chaîne. Un seul achat déverrouille toutes les fonctionnalités sur iPhone, iPad, Mac et Apple TV, pour tous les membres de votre groupe de Partage familial."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Antenna reproduz as fontes de TV que você já tem e não inclui canais. Uma compra desbloqueia todos os recursos no iPhone, iPad, Mac e Apple TV, para todos do seu grupo de Compartilhamento Familiar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna spelar upp de TV-källor du redan har och innehåller inga kanaler. Ett köp låser upp alla funktioner på iPhone, iPad, Mac och Apple TV, för alla i din familjegrupp."
          }
        }
      }
    },
    "Antenna reads M3U playlists: #EXTINF lines, each followed by a stream link. This file has no such pair." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna liest M3U-Playlists: #EXTINF-Zeilen, jeweils gefolgt von einem Stream-Link. Diese Datei hat kein solches Paar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna lee listas M3U: líneas #EXTINF, cada una seguida de un enlace de transmisión. Este archivo no tiene ninguna pareja así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antenna lit les playlists M3U : des lignes #EXTINF, chacune suivie d’un lien de flux. Ce fichier ne contient aucune paire de ce type."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Antenna lê playlists M3U: linhas #EXTINF, cada uma seguida de um link de transmissão. Este arquivo não tem nenhum par assim."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna läser M3U-spellistor: #EXTINF-rader, var och en följd av en strömlänk. Den här filen har inget sådant par."
          }
        }
      }
    },
    "Antenna reads the guide links from the playlist when it finishes loading." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna liest die Programmführer-Links aus der Playlist, wenn sie fertig geladen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna lee los enlaces de guía de la lista cuando termina de cargarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antenna lit les liens de guide de la playlist quand elle a fini de se charger."
