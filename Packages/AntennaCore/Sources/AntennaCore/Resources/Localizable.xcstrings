    "Check the connection and try again. If you already bought Antenna, Restore purchase finds it once the connection is back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Verbindung und versuche es erneut. Wenn du Antenna bereits gekauft hast, findet „Kauf wiederherstellen“ den Kauf, sobald die Verbindung wieder da ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la conexión y vuelve a intentarlo. Si ya compraste Antenna, Restaurar compra la encontrará cuando vuelva la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifiez la connexion et réessayez. Si vous avez déjà acheté Antenna, Restaurer l’achat le retrouvera une fois la connexion rétablie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a conexão e tente de novo. Se você já comprou o Antenna, Restaurar compra encontra a compra quando a conexão voltar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera anslutningen och försök igen. Om du redan har köpt Antenna hittar Återställ köp det när anslutningen är tillbaka."
