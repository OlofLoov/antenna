        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antenna lee listas M3U: líneas #EXTINF, cada una seguida de un enlace de emisión. Este archivo no tiene ninguna pareja así."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna läser M3U-spellistor: #EXTINF-rader, var och en följd av en strömlänk. Den här filen har inget sådant par."
          }
        }
      }
    },
    "Antenna reads the guide links from the playlist when it finishes loading." : {
