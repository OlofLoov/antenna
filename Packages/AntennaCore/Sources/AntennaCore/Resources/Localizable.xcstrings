    "%@ rejected the login. Check the username and password in Settings, or ask the provider whether the account has expired." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض %@ تسجيل الدخول. تحقق من اسم المستخدم وكلمة السر في الإعدادات، أو اسأل المزود إن كان الحساب قد انتهى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Anmeldung abgelehnt. Prüfe Benutzername und Passwort in den Einstellungen oder frag den Anbieter, ob das Konto abgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechazó el inicio de sesión. Revisa el usuario y la contraseña en Ajustes, o pregunta al proveedor si la cuenta ha vencido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a refusé la connexion. Vérifiez le nom d’utilisateur et le mot de passe dans Réglages, ou demandez au fournisseur si le compte a expiré."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recusou o login. Confira o usuário e a senha em Ajustes, ou pergunte ao provedor se a conta expirou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avvisade inloggningen. Kontrollera användarnamnet och lösenordet i Inställningar, eller fråga leverantören om kontot har gått ut."
          }
        }
      }
    },
    "%@ rejected the login. Sign in again on this Apple TV, or ask the provider whether the account has expired." : {
