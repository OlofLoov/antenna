    "Antenna is still loading your library. Try again in a moment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال Antenna يحمّل مكتبتك. حاول مرة أخرى بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna lädt noch deine Bibliothek. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna sigue cargando tu biblioteca. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna charge encore votre bibliothèque. Réessayez dans un instant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Antenna ainda está carregando sua biblioteca. Tente de novo em instantes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna läser fortfarande in ditt bibliotek. Försök igen om en stund."
          }
        }
      }
    },
    "Antenna isn't playing a channel right now. Say which channel instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يشغّل Antenna أي قناة الآن. قل اسم القناة بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna spielt gerade keinen Sender ab. Sag stattdessen, welcher Sender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna no está reproduciendo ningún canal ahora mismo. Di qué canal quieres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna ne lit aucune chaîne pour le moment. Indiquez plutôt quelle chaîne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
