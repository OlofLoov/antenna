    "Antenna can't verify this server's certificate. Use http on your network or a trusted certificate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Antenna التحقق من شهادة هذا الخادم. استخدم http على شبكتك أو شهادة موثوقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna kann das Zertifikat dieses Servers nicht prüfen. Verwende http in deinem Netzwerk oder ein vertrauenswürdiges Zertifikat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna no puede verificar el certificado de este servidor. Usa http en tu red o un certificado de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna ne peut pas vérifier le certificat de ce serveur. Utilisez http sur votre réseau ou un certificat de confiance."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Antenna não consegue verificar o certificado deste servidor. Use http na sua rede ou um certificado confiável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna kan inte verifiera serverns certifikat. Använd http i ditt nätverk eller ett betrott certifikat."
          }
        }
      }
    },
    "Antenna couldn't reach %@. Try again later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
