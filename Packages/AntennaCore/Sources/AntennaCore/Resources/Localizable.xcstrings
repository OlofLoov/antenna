    "This stream uses %@, which this device cannot play. Trying again will not help. Pick another channel or ask the provider for a stream in a supported format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم هذا البث %@، ولا يستطيع هذا الجهاز تشغيله. لن تفيد إعادة المحاولة. اختر قناة أخرى أو اطلب من المزود بثًا بصيغة مدعومة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Stream verwendet %@, das dieses Gerät nicht abspielen kann. Ein neuer Versuch hilft nicht. Wähle einen anderen Sender oder bitte den Anbieter um einen Stream in einem unterstützten Format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transmisión usa %@, que este dispositivo no puede reproducir. Reintentar no servirá. Elige otro canal o pide al proveedor una transmisión en un formato compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce flux utilise %@, que cet appareil ne peut pas lire. Réessayer n’y changera rien. Choisissez une autre chaîne ou demandez au fournisseur un flux dans un format pris en charge."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transmissão usa %@, que este dispositivo não consegue reproduzir. Tentar de novo não vai ajudar. Escolha outro canal ou peça ao provedor uma transmissão em um formato compatível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här strömmen använder %@, som den här enheten inte kan spela. Det hjälper inte att försöka igen. Välj en annan kanal eller be leverantören om en ström i ett format som stöds."
          }
        }
      }
    },
