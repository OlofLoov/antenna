    "Renews every year. Cancel any time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد كل سنة. يمكنك الإلغاء في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich jedes Jahr. Jederzeit kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva cada año. Cancela cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renouvelle chaque année. Résiliable à tout moment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova todo ano. Cancele quando quiser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas varje år. Avsluta när du vill."
          }
        }
      }
    },
    "Renews on %@. Your sources and favorites are where you left them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد في %@. مصادرك ومفضلتك كما تركتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich am %@. Deine Quellen und Favoriten sind da, wo du sie gelassen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva el %@. Tus fuentes y favoritos están donde los dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement le %@. Vos sources et favoris sont là où vous les avez laissés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova em %@. Suas fontes e favoritos estão onde você os deixou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas %@. Dina källor och favoriter är där du lämnade dem."
          }
        }
      }
    },
