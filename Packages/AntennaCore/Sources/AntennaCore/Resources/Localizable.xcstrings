    "%@ knows the channel but carries no programmes for it. Pick another entry below, or wait for the provider to fill it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ kennt den Sender, hat aber keine Sendungen dafür. Wähle unten einen anderen Eintrag oder warte, bis der Anbieter ihn füllt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ conoce el canal pero no tiene programas para él. Elige otra entrada abajo o espera a que el proveedor la complete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ känner till kanalen men har inga program för den. Välj en annan post nedan, eller vänta tills leverantören fyller på den."
          }
        }
      }
    },
    "%@ lists programmes for this channel but none after now. Wait for the next guide refresh or pick another entry below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ listet Sendungen für diesen Sender, aber keine ab jetzt. Warte auf die nächste Aktualisierung des Programmführers oder wähle unten einen anderen Eintrag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ tiene programas para este canal, pero ninguno a partir de ahora. Espera a la próxima actualización de la guía o elige otra entrada abajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ listar program för den här kanalen men inga från och med nu. Vänta på nästa tablåuppdatering eller välj en annan post nedan."
          }
        }
      }
    },
    "%@ per %@ for %@, then %@ per year" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ pro %2$@ für %3$@, danach %4$@ pro Jahr"
          }
        },
