ANTENNA_PAID_TEAM = YES
#include? "Local.xcconfig"

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
EXCLUDED_ARCHS[sdk=appletvsimulator*] = x86_64
EXCLUDED_ARCHS[sdk=macosx*] = x86_64
ANTENNA_ENTITLEMENTS_SUFFIX_NO = Personal
ANTENNA_ENTITLEMENTS_SUFFIX = $(ANTENNA_ENTITLEMENTS_SUFFIX_$(ANTENNA_PAID_TEAM))
ANTENNA_CLOUDKIT_CONTAINER_YES_YES = iCloud.se.codecrave.antenna
ANTENNA_CLOUDKIT_CONTAINER = $(ANTENNA_CLOUDKIT_CONTAINER_$(CODE_SIGNING_ALLOWED)_$(ANTENNA_PAID_TEAM))
ANTENNA_KEYCHAIN_GROUP_YES = $(AppIdentifierPrefix)se.codecrave.antenna.shared
ANTENNA_KEYCHAIN_GROUP = $(ANTENNA_KEYCHAIN_GROUP_$(CODE_SIGNING_ALLOWED))
