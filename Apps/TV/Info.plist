	<string>https://codecrave.se/antenna/privacy</string>
	<key>AntennaTermsURL</key>
	<string>https://codecrave.se/antenna/terms</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Antenna</string>
