    "A source arrived from iCloud that this Apple TV can't set up here. Update Antenna, or type the source here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل من iCloud مصدر لا يستطيع Apple TV هذا إعداده هنا. حدّث Antenna، أو اكتب المصدر هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus iCloud kam eine Quelle, die dieses Apple TV hier nicht einrichten kann. Aktualisiere Antenna oder gib die Quelle hier ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegó una fuente desde iCloud que este Apple TV no puede configurar aquí. Actualiza Antenna o escribe la fuente aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une source arrivée depuis iCloud ne peut pas être configurée sur cette Apple TV. Mettez à jour Antenna ou saisissez la source ici."
          }
