    "Keep the sign-in open on the Apple TV. If the code there changed, scan the new one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ تسجيل الدخول مفتوحًا على Apple TV. إذا تغيّر الرمز هناك، امسح الرمز الجديد."
          }
