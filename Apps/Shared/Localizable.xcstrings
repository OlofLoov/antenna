    },
    "Through iCloud. Antenna on the Apple TV picks it up on its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبر iCloud. يستلمه Antenna على Apple TV تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über iCloud. Antenna auf dem Apple TV holt sie automatisch ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A través de iCloud. Antenna en el Apple TV lo recoge automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via iCloud. Antenna sur l’Apple TV la récupère automatiquement."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo iCloud. O Antenna no Apple TV recebe automaticamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via iCloud. Antenna på Apple TV:n hämtar den automatiskt."
          }
        }
      }
    },
    "Titles and people you open, and names you search for, are looked up in TMDB. Nothing about you or your sources is sent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبحث عن العناوين والأشخاص الذين تفتحهم، والأسماء التي تبحث عنها، في TMDB. لا يُرسل شيء عنك أو عن مصادرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel und Personen, die du öffnest, und Namen, nach denen du suchst, werden bei TMDB nachgeschlagen. Nichts über dich oder deine Quellen wird gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los títulos y las personas que abres, y los nombres que buscas, se consultan en TMDB. No se envía nada sobre ti ni sobre tus fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres et personnes que vous ouvrez, et les noms que vous recherchez, sont consultés sur TMDB. Rien sur vous ou vos sources n’est envoyé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títulos e pessoas que você abre, e nomes que você busca, são consultados no TMDB. Nada sobre você ou suas fontes é enviado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titlar och personer du öppnar, och namn du söker efter, slås upp i TMDB. Inget om dig eller dina källor skickas."
          }
        }
      }
    },
    "Toggle" : {
      "localizations" : {
