    "Saved in your iCloud Keychain only. Antenna has no servers and never sees your login." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ في سلسلة مفاتيح iCloud فقط. ليس لدى Antenna خوادم ولا يرى تسجيل دخولك أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in deinem iCloud-Schlüsselbund gespeichert. Antenna hat keine Server und sieht deine Anmeldung nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado solo en tu llavero de iCloud. Antenna no tiene servidores y nunca ve tu inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré uniquement dans votre trousseau iCloud. Antenna n’a aucun serveur et ne voit jamais votre connexion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado só nas suas Chaves do iCloud. O Antenna não tem servidores e nunca vê seu login."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparas bara i din iCloud-nyckelring. Antenna har inga servrar och ser aldrig din inloggning."
          }
        }
      }
    },
    "Saved on this %@" : {
