          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här %@ är inte inloggad på iCloud, så källan kan inte nå din Apple TV. Logga in på iCloud i Inställningar så skickas den automatiskt."
