    "Hide, lock, rename and reorder. Changes reach every device signed into your iCloud." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخفِ وأقفل وأعد التسمية وأعد الترتيب. تصل التغييرات إلى كل جهاز مسجّل الدخول إلى iCloud الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausblenden, sperren, umbenennen und sortieren. Änderungen erreichen jedes Gerät, das mit deinem iCloud-Account angemeldet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta, bloquea, renombra y reordena. Los cambios llegan a todos los dispositivos con tu iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer, verrouiller, renommer et réordonner. Les modifications s’appliquent à tous les appareils connectés à votre iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar, bloquear, renomear e reordenar. As mudanças chegam a todos os dispositivos conectados ao seu iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj, lås, byt namn och ändra ordning. Ändringarna når alla enheter som är inloggade på ditt iCloud-konto."
          }
        }
      }
    },
