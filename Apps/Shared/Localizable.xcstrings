        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este %@ no ha iniciado sesión en iCloud, así que no puede enviar inicios de sesión a tu Apple TV. Inicia sesión en iCloud en Ajustes y vuelve a escanear el código."
          }
        },
        "sv" : {
          "stringUnit" : {
