            "value" : "لا يوجد على %@ هذا أي من المصادر التي طلبها Apple TV. يحتاج الجهازان إلى حساب iCloud نفسه، وقد تستغرق المصادر الجديدة دقيقة لتصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine der Quellen, die dieses Apple TV angefordert hat, ist auf diesem %@. Beide brauchen denselben iCloud-Account, und neue Quellen können eine Minute brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna de las fuentes que pidió este Apple TV está en este %@. Ambos necesitan la misma cuenta de iCloud, y las fuentes nuevas pueden tardar un minuto en llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune des sources demandées par cette Apple TV n’est sur votre %@. Les deux doivent utiliser le même compte iCloud, et les nouvelles sources peuvent mettre une minute à arriver."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma das fontes pedidas por este Apple TV está neste %@. Os dois precisam da mesma conta do iCloud, e fontes novas podem levar um minuto para chegar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av källorna som Apple TV:n bad om finns på den här %@. Båda behöver samma iCloud-konto, och nya källor kan ta en minut att komma fram."
          }
        }
      }
    },
