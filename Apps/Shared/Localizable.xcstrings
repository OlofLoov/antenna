    },
    "Copy these from the email or page your provider sent you. Leave the login empty unless your provider gave you one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخها من البريد الإلكتروني أو الصفحة التي أرسلها مزودك. اترك تسجيل الدخول فارغًا ما لم يعطك مزودك واحدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere sie aus der E-Mail oder von der Seite, die dir dein Anbieter geschickt hat. Lass die Anmeldung leer, wenn dein Anbieter dir keine gegeben hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópialos del correo o la página que te envió tu proveedor. Deja el inicio de sesión vacío salvo que tu proveedor te haya dado uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez-les depuis l’e-mail ou la page envoyés par votre fournisseur. Laissez la connexion vide sauf si votre fournisseur vous en a donné une."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie do e-mail ou da página que seu provedor enviou. Deixe o login em branco, a menos que seu provedor tenha dado um."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiera dem från mejlet eller sidan som din leverantör skickade. Lämna inloggningen tom om din leverantör inte gav dig någon."
          }
        }
      }
    },
