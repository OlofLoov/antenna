    "Check that this %@ is online and signed in to iCloud. It sends on its own once it can." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن %@ هذا متصل بالإنترنت ومسجّل الدخول إلى iCloud. سيُرسل تلقائيًا عندما يستطيع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob dein %@ online und bei iCloud angemeldet ist. Es sendet automatisch, sobald es kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que este %@ tiene conexión y ha iniciado sesión en iCloud. Se enviará automáticamente en cuanto pueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que votre %@ est en ligne et connecté à iCloud. L’envoi se fera automatiquement dès que possible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se este %@ está online e conectado ao iCloud. O envio é feito automaticamente assim que possível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera att den här %@ är online och inloggad på iCloud. Den skickar automatiskt så snart den kan."
          }
        }
      }
    },
    "Checked with the server first, then kept in your iCloud Keychain on this %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التحقق منه مع الخادم أولًا، ثم حُفظ في سلسلة مفاتيح iCloud على %@ هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst mit dem Server geprüft, dann in deinem iCloud-Schlüsselbund auf diesem %@ gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobado primero con el servidor y luego guardado en tu llavero de iCloud en este %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifié d’abord auprès du serveur, puis conservé dans le trousseau iCloud de votre %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificado primeiro com o servidor e depois guardado nas suas Chaves do iCloud neste %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolleras först mot servern och sparas sedan i din iCloud-nyckelring på den här %@."
          }
        }
      }
    },
    "Checking the login…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ التحقق من تسجيل الدخول…"
