    "Check that this %@ is online and signed in to iCloud. It sends on its own once it can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prüfe, ob dieses %@ online und bei iCloud angemeldet ist. Es sendet von selbst, sobald es kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprueba que este %@ tiene conexión y ha iniciado sesión en iCloud. Lo enviará solo en cuanto pueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifiez que cet %@ est en ligne et connecté à iCloud. Il enverra tout seul dès que possible."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera att den här %@ är online och inloggad på iCloud. Den skickar automatiskt så snart den kan."
          }
        }
      }
    },
    "Checked with the server first, then kept in your iCloud Keychain on this %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zuerst mit dem Server geprüft, dann in deinem iCloud-Schlüsselbund auf diesem %@ gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comprobado primero con el servidor y luego guardado en tu llavero de iCloud en este %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vérifié d’abord auprès du serveur, puis conservé dans votre trousseau iCloud sur cet %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolleras först mot servern och sparas sedan i din iCloud-nyckelring på den här %@."
          }
        }
      }
    },
    "Checking the login…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anmeldung wird geprüft …"
          }
        },
