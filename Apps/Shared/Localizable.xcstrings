    "It checks them with the provider and signs in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق منها مع المزود ويسجّل الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es prüft sie beim Anbieter und meldet sich an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comprueba con el proveedor e inicia sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle les vérifie auprès du fournisseur et se connecte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele verifica com o provedor e entra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kontrollerar dem hos leverantören och loggar in."
          }
        }
      }
    },
    "Its favorites, hidden groups and history go too. Sources stay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف معه أيضًا مفضلاته ومجموعاته المخفية وسجله. تبقى المصادر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Favoriten, ausgeblendeten Gruppen und sein Verlauf werden ebenfalls gelöscht. Quellen bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se van sus favoritos, grupos ocultos e historial. Las fuentes se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses favoris, groupes masqués et historique sont aussi supprimés. Les sources restent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os favoritos, grupos ocultos e histórico dele também vão embora. As fontes ficam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess favoriter, dolda grupper och historik försvinner också. Källorna finns kvar."
          }
        }
      }
    },
    "Its saved login is unreadable. Re-import the file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول المحفوظ لا يمكن قراءته. أعد استيراد الملف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Anmeldung ist nicht lesbar. Importiere die Datei erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su inicio de sesión guardado no se puede leer. Vuelve a importar el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa connexion enregistrée est illisible. Importez à nouveau le fichier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login guardado não pode ser lido. Importe o arquivo de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den sparade inloggningen går inte att läsa. Importera filen igen."
          }
        }
      }
    },
