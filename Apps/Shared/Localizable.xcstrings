    "Allow notifications" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen erlauben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permitir notificaciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autoriser les notifications"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permitir notificações"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt notiser"
          }
        }
      }
    },
    "An unlocked iPhone or iPad nearby offers its keyboard for this Apple TV. Tap that notification and the fields fill in here as you type. Or add the source in Antenna on iPhone and it syncs over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein entsperrtes iPhone oder iPad in der Nähe bietet seine Tastatur für dieses Apple TV an. Tippe auf die Mitteilung, dann füllen sich die Felder hier beim Tippen. Oder füge die Quelle in Antenna auf dem iPhone hinzu, dann wird sie hierher synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un iPhone o iPad desbloqueado cercano ofrece su teclado para este Apple TV. Toca esa notificación y los campos se rellenan aquí mientras escribes. O añade la fuente en Antenna en el iPhone y se sincronizará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un iPhone ou iPad déverrouillé à proximité propose son clavier pour cette Apple TV. Touchez la notification et les champs se remplissent ici pendant que vous tapez. Ou ajoutez la source dans Antenna sur l’iPhone et elle sera synchronisée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um iPhone ou iPad desbloqueado por perto oferece o teclado para este Apple TV. Toque na notificação e os campos são preenchidos aqui enquanto você digita. Ou adicione a fonte no Antenna no iPhone e ela sincroniza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En upplåst iPhone eller iPad i närheten erbjuder sitt tangentbord för den här Apple TV:n. Tryck på notisen så fylls fälten i här medan du skriver. Eller lägg till källan i Antenna på iPhone så synkas den hit."
          }
        }
      }
    },
    "Antenna" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antenna"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antenna"
          }
        },
        "fr" : {
          "stringUnit" : {
