    "192.168.1.20 or nas.local" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "192.168.1.20 eller nas.local"
          }
        }
      }
    },
    "A Channels DVR server on your home network." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Channels DVR-server i ditt hemnätverk."
          }
        }
      }
    },
    "A link ending in .m3u or .m3u8, with an optional guide link." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En länk som slutar på .m3u eller .m3u8, med en valfri tablålänk."
          }
        }
      }
    },
    "A link ending in .m3u or .m3u8. It lists every channel with its stream address. A second link, in XMLTV format, carries the programme guide and is optional." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En länk som slutar på .m3u eller .m3u8. Den listar varje kanal med dess strömadress. En andra länk, i XMLTV-format, innehåller programtablån och är valfri."
          }
        }
      }
    },
    "A link with a login or token is kept in your iCloud Keychain only." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En länk med inloggning eller token sparas bara i din iCloud-nyckelring."
          }
        }
      }
    },
    "A portal address and a MAC address." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En portaladress och en MAC-adress."
          }
        }
      }
    },
    "A server address with a username and password, sometimes called Xtream Codes. The server answers with channels, guide, movies and series, so there is nothing else to add. The login is saved in the Keychain on this Apple TV." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En serveradress med användarnamn och lösenord, ibland kallat Xtream Codes. Servern svarar med kanaler, tablå, filmer och serier, så det finns inget mer att lägga till. Inloggningen sparas i nyckelringen på den här Apple TV:n."
          }
        }
      }
    },
    "A server address with a username and password, sometimes called Xtream Codes. The server answers with channels, guide, movies and series, so there is nothing else to add. The login is saved in your iCloud Keychain." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En serveradress med användarnamn och lösenord, ibland kallat Xtream Codes. Servern svarar med kanaler, tablå, filmer och serier, så det finns inget mer att lägga till. Inloggningen sparas i din iCloud-nyckelring."
          }
        }
      }
    },
    "A server address with a username and password." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En serveradress med användarnamn och lösenord."
          }
        }
      }
    },
    "A source arrived from iCloud that this Apple TV can't set up here. Update Antenna, or type the source here." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En källa kom från iCloud som den här Apple TV:n inte kan ställa in här. Uppdatera Antenna eller skriv in källan här."
          }
        }
      }
    },
