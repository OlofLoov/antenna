          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enlace con usuario o token se guarda solo en tu llavero de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien avec identifiant ou jeton est conservé uniquement dans votre trousseau iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um link com login ou token fica guardado só nas suas Chaves do iCloud."
          }
        },
