        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código ya se usó. Si el Apple TV aún necesita un inicio de sesión, muestra un código nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code a déjà été utilisé. Si l’Apple TV a encore besoin d’une connexion, elle affiche un nouveau code."
          }
        },
        "pt-BR" : {
