    "The login stays in your iCloud Keychain. If the Apple TV asks for it, enter it once there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى تسجيل الدخول في سلسلة مفاتيح iCloud. إذا طلبه Apple TV، أدخله هناك مرة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung bleibt in deinem iCloud-Schlüsselbund. Wenn das Apple TV danach fragt, gib sie dort einmal ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión se queda en tu llavero de iCloud. Si el Apple TV lo pide, introdúcelo una vez allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion reste dans votre trousseau iCloud. Si l’Apple TV la demande, saisissez-la une fois là-bas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
