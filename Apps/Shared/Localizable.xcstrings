    "A link ending in .m3u or .m3u8, with an optional guide link." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رابط ينتهي بـ ‎.m3u أو ‎.m3u8، مع رابط دليل اختياري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Link, der auf .m3u oder .m3u8 endet, mit einem optionalen Programmführer-Link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enlace que termina en .m3u o .m3u8, con un enlace de guía opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien se terminant par .m3u ou .m3u8, avec un lien de guide facultatif."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um link terminado em .m3u ou .m3u8, com um link de guia opcional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En länk som slutar på .m3u eller .m3u8, med en valfri tablålänk."
          }
        }
      }
    },
    "A link ending in .m3u or .m3u8. It lists every channel with its stream address. A second link, in XMLTV format, carries the programme guide and is optional." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رابط ينتهي بـ ‎.m3u أو ‎.m3u8. يسرد كل قناة مع عنوان بثها. ورابط ثانٍ بصيغة XMLTV يحمل دليل البرامج، وهو اختياري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Link, der auf .m3u oder .m3u8 endet. Er listet jeden Sender mit seiner Streamadresse. Ein zweiter Link im XMLTV-Format enthält den Programmführer und ist optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enlace que termina en .m3u o .m3u8. Enumera cada canal con su dirección de transmisión. Un segundo enlace, en formato XMLTV, contiene la guía de programación y es opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien se terminant par .m3u ou .m3u8. Il liste chaque chaîne avec son adresse de flux. Un second lien, au format XMLTV, contient le guide des programmes et est facultatif."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um link terminado em .m3u ou .m3u8. Ele lista cada canal com o endereço da transmissão. Um segundo link, no formato XMLTV, traz o guia de programação e é opcional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En länk som slutar på .m3u eller .m3u8. Den listar varje kanal med dess strömadress. En andra länk, i XMLTV-format, innehåller programtablån och är valfri."
          }
        }
      }
    },
    "A link with a login or token is kept in your iCloud Keychain only." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرابط الذي يحتوي على تسجيل دخول أو رمز يُحفظ في سلسلة مفاتيح iCloud فقط."
          }
        },
        "de" : {
