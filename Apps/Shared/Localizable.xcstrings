    "This code is from a newer Antenna. Update Antenna on this %@ to set up your Apple TV from here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الرمز من إصدار أحدث من Antenna. حدّث Antenna على %@ هذا لإعداد Apple TV من هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code stammt von einer neueren Antenna-Version. Aktualisiere Antenna auf diesem %@, um dein Apple TV von hier einzurichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código es de una versión más nueva de Antenna. Actualiza Antenna en este %@ para configurar tu Apple TV desde aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code vient d’une version plus récente d’Antenna. Mettez à jour Antenna sur votre %@ pour configurer votre Apple TV d’ici."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código é de um Antenna mais novo. Atualize o Antenna neste %@ para configurar seu Apple TV por aqui."
