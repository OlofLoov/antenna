    "A link ending in .m3u or .m3u8, with an optional guide link." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Link, der auf .m3u oder .m3u8 endet, mit einem optionalen Programmführer-Link."
          }
        },
        "es" : {
          "stringUnit" : {
