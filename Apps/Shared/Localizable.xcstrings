    },
    "This %@ isn't signed in to iCloud, so it can't send logins to your Apple TV. Sign in to iCloud in Settings, then scan the code again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسجَّل دخول %@ هذا إلى iCloud، لذا لا يمكنه إرسال تسجيلات الدخول إلى Apple TV. سجّل الدخول إلى iCloud في الإعدادات، ثم امسح الرمز مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@ ist nicht bei iCloud angemeldet und kann daher keine Anmeldungen an dein Apple TV senden. Melde dich in den Einstellungen bei iCloud an und scanne den Code dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ no ha iniciado sesión en iCloud, así que no puede enviar inicios de sesión a tu Apple TV. Inicia sesión en iCloud en Ajustes y vuelve a escanear el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre %@ n’est pas connecté à iCloud, il ne peut donc pas envoyer de connexions à votre Apple TV. Connectez-vous à iCloud dans Réglages, puis scannez à nouveau le code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ não está conectado ao iCloud, então não pode enviar logins ao seu Apple TV. Entre no iCloud em Ajustes e escaneie o código de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här %@ är inte inloggad på iCloud, så den kan inte skicka inloggningar till din Apple TV. Logga in på iCloud i Inställningar och skanna sedan koden igen."
          }
        }
      }
    },
    "This %@ isn't signed in to iCloud, so the source can't reach your Apple TV. Sign in to iCloud in Settings and it sends on its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسجَّل دخول %@ هذا إلى iCloud، لذا لا يمكن أن يصل المصدر إلى Apple TV. سجّل الدخول إلى iCloud في الإعدادات وسيُرسل تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@ ist nicht bei iCloud angemeldet, daher kann die Quelle dein Apple TV nicht erreichen. Melde dich in den Einstellungen bei iCloud an, dann wird sie automatisch gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ no ha iniciado sesión en iCloud, así que la fuente no puede llegar a tu Apple TV. Inicia sesión en iCloud en Ajustes y se enviará automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre %@ n’est pas connecté à iCloud, la source ne peut donc pas atteindre votre Apple TV. Connectez-vous à iCloud dans Réglages et elle sera envoyée automatiquement."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este %@ não está conectado ao iCloud, então a fonte não chega ao seu Apple TV. Entre no iCloud em Ajustes e ela é enviada automaticamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här %@ är inte inloggad på iCloud, så källan kan inte nå din Apple TV. Logga in på iCloud i Inställningar så skickas den automatiskt."
          }
        }
      }
    },
    "This channel is locked." : {
      "localizations" : {
