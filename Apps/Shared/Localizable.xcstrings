          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link ist eine Xtream-Anmeldung. Füge ihn als Xtream hinzu, um Filme, Serien und den Programmführer zu bekommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este enlace es un inicio de sesión Xtream. Añádelo como Xtream para tener películas, series y la guía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien est une connexion Xtream. Ajoutez-le comme Xtream pour obtenir les films, les séries et le guide."
