    "Scan the code with your iPhone camera. Antenna there sends the login to this Apple TV, encrypted, through iCloud." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز بكاميرا iPhone. سيرسل Antenna هناك تسجيل الدخول إلى Apple TV هذا، مشفرًا، عبر iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit deiner iPhone-Kamera. Antenna sendet die Anmeldung von dort verschlüsselt über iCloud an dieses Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con la cámara del iPhone. Antenna allí envía el inicio de sesión a este Apple TV, cifrado, a través de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec l’appareil photo de votre iPhone. Antenna y envoie la connexion chiffrée à cette Apple TV via iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código com a câmera do iPhone. O Antenna lá envia o login a este Apple TV, criptografado, pelo iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna koden med iPhone-kameran. Antenna på iPhone skickar sedan inloggningen krypterad via iCloud till den här Apple TV:n."
          }
        }
      }
    },
