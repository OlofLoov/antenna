    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Antuna بخوادم التلفزيون على شبكتك المنزلية عندما يشير أحد مصادرك إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antuna verbindet sich mit TV-Servern in deinem Heimnetzwerk, wenn eine deiner Quellen dorthin zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Antuna connects to TV servers on your home network when one of your sources points there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antuna se conecta a servidores de TV de tu red doméstica cuando una de tus fuentes apunta allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antuna se connecte aux serveurs TV de votre réseau domestique quand l’une de vos sources y renvoie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Antuna se conecta a servidores de TV na sua rede doméstica quando uma das suas fontes aponta para lá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antuna ansluter till TV-servrar i ditt hemnätverk när någon av dina källor pekar dit."
